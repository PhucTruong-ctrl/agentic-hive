#!/usr/bin/env bash
# hive-launch — start or attach a persistent member session in tmux.
#
#   hive-launch <member> [harness] [dir] [-- harness args...]
#   hive-launch --list
#
# Members run as the `hive` account. When invoked by another user (the
# Beekeeper), re-executes itself through sudo.
set -euo pipefail

HIVE_ROOT="${HIVE_ROOT:-/srv/hive}"
HIVE_USER="${HIVE_USER:-hive}"
SHARE="${HIVE_SHARE:-$(dirname "$(readlink -f "$0")")/../share/agentic-hive}"
[[ -d $SHARE ]] || SHARE="$(dirname "$(readlink -f "$0")")/../share"

die() { printf 'hive-launch: %s\n' "$*" >&2; exit 1; }

if [[ $(id -un) != "$HIVE_USER" ]]; then
  exec sudo -u "$HIVE_USER" -i -- hive-launch "$@"
fi

# Harness facts (executable, resume argv, prompt injection, hook file, event
# names) live in one table shared with hive-member and hive-hook.
[[ -f $SHARE/harness.sh ]] || die "harness table not found: $SHARE/harness.sh"
. "$SHARE/harness.sh"
harnesses=$(harness_list | paste -sd'|' -)
require_harness() {
  harness_fact "$1" exe >/dev/null 2>&1 || die "unknown harness: $1 (supported: $harnesses)"
}

# Two mechanisms: vendor JSON config (most harnesses) vs shipped bridge
# module (omp, pi, opencode) installed under $HOME.
install_hooks() {
  local h="$1" hook cfg f v1 v2 v3 v4 v5 want
  # cline registers hooks as executable files in ~/.cline/hooks, not a config
  # file. No honest file to write here: say Room awareness is unavailable
  # rather than writing a schema cline would ignore.
  if [[ $h == cline ]]; then
    echo "hive-launch: cline loads hooks as executable files in ~/.cline/hooks (no settings file); Room awareness unavailable for cline" >&2
    return 0
  fi
  local mod src src_path dest
  cfg=$(harness_fact "$h" hook_config || true)
  mod=$(harness_fact "$h" hook_module || true)
  if [[ -n $mod ]]; then
    src=$(harness_fact "$h" hook_module_src || true)
    src_path="$SHARE/$src"
    if [[ -f $src_path ]]; then
      dest="$HOME/$mod"
      mkdir -p "$(dirname "$dest")"
      if [[ -f $dest && $(cat "$dest") == $(cat "$src_path") ]]; then
        : # idempotent, unchanged
      else
        cp -a "$src_path" "$dest"
        chmod 0644 "$dest"
      fi
    else
      echo "hive-launch: bridge source missing for $h: $src_path" >&2
    fi
    return 0
  fi
  [[ -n $cfg ]] || return 0
  # Prefer the host-managed CLI directory so the file (and the harness's trust
  # hash for it) stays stable across host updates; fall back to PATH.
  hook="${HIVE_BIN_DIR:+${HIVE_BIN_DIR}/hive-hook}"
  [[ -n $hook && -x $hook ]] || hook=$(command -v hive-hook) || {
    echo "hive-launch: hive-hook not found; $h runs without Room awareness" >&2
    return 0
  }
  v1=$(harness_fact "$h" event:SessionStart)
  v2=$(harness_fact "$h" event:UserPromptSubmit)
  v3=$(harness_fact "$h" event:PostToolUse)
  v4=$(harness_fact "$h" event:Stop)
  v5=$(harness_fact "$h" event:SessionEnd)
  f="$HOME/$cfg"
  # Config keys use the vendor's event spelling; the command's event argument
  # stays a Hive name because that is what hive-hook dispatches on.
  case $h in
    qwen) # qwen takes a matcher entry on every event, tool or not
      want=$(jq -n --arg cmd "$hook $h" --arg v1 "$v1" --arg v2 "$v2" --arg v3 "$v3" --arg v4 "$v4" --arg v5 "$v5" '
        def on($ev): [{matcher: "*", hooks: [{type: "command", command: "\($cmd) \($ev)"}]}];
        {hooks: {($v1): on("SessionStart"), ($v2): on("UserPromptSubmit"), ($v3): on("PostToolUse"),
                 ($v4): on("Stop"), ($v5): on("SessionEnd")}}')
      ;;
    codex | letta) # Claude-style: matcher only on the tool event
      want=$(jq -n --arg cmd "$hook $h" --arg v1 "$v1" --arg v2 "$v2" --arg v3 "$v3" --arg v4 "$v4" --arg v5 "$v5" '
        def on($ev): [{hooks: [{type: "command", command: "\($cmd) \($ev)"}]}];
        {hooks: {($v1): on("SessionStart"), ($v2): on("UserPromptSubmit"),
                 ($v3): [{matcher: "*", hooks: [{type: "command", command: "\($cmd) PostToolUse"}]}],
                 ($v4): on("Stop"), ($v5): on("SessionEnd")}}')
      ;;
    cursor) # native .cursor/hooks.json takes flat entries, not Claude's nested shape
      want=$(jq -n --arg cmd "$hook $h" --arg v1 "$v1" --arg v2 "$v2" --arg v3 "$v3" --arg v4 "$v4" --arg v5 "$v5" '
        {version: 1,
         hooks: {($v1): [{command: "\($cmd) SessionStart"}],
                 ($v2): [{command: "\($cmd) UserPromptSubmit"}],
                 ($v3): [{command: "\($cmd) PostToolUse", matcher: "*"}],
                 ($v4): [{command: "\($cmd) Stop"}],
                 ($v5): [{command: "\($cmd) SessionEnd"}]}}')
      ;;
    openhands) # snake_case keys at top level; entries carry no type field
      want=$(jq -n --arg cmd "$hook $h" --arg v1 "$v1" --arg v2 "$v2" --arg v3 "$v3" --arg v4 "$v4" --arg v5 "$v5" '
        def on($ev): [{matcher: "*", hooks: [{command: "\($cmd) \($ev)", timeout: 60}]}];
        {($v1): on("SessionStart"), ($v2): on("UserPromptSubmit"), ($v3): on("PostToolUse"),
         ($v4): on("Stop"), ($v5): on("SessionEnd")}')
      ;;
    *) return 0 ;;
  esac
  mkdir -p "$(dirname "$f")"
  [[ -f $f && $(cat "$f") == "$want" ]] || printf '%s\n' "$want" >"$f"
}

# Inner mode: runs inside the tmux pane.
if [[ ${1:-} == --run ]]; then
  shift
  harness="$1"; shift
  require_harness "$harness"
  # Keep members on the host's current CLI after host updates, rather than
  # inheriting this session's pinned package path for its lifetime.
  if [[ -n ${HIVE_BIN_DIR:-} && -x $HIVE_BIN_DIR/hive && $(readlink -f "$HIVE_BIN_DIR") != $(dirname "$(readlink -f "$0")") ]]; then
    export PATH="$HIVE_BIN_DIR:$PATH"
  fi
  install_hooks "$harness"
  # Permission defaults that apply on every autonomous run; the harness table
  # carries prompt injection, not these vendor launch flags.
  args=()
  case $harness in
    claude) args=(--permission-mode auto) ;;
    codex) args=(--approve-for-me --add-dir "$HIVE_ROOT") ;;
  esac
  prompt=$(harness_fact "$harness" prompt)
  case $prompt in
    flag-append:* | flag-replace:*) args+=("${prompt#*:}" "$(cat "$SHARE/member-instruction.md")") ;;
    config:*) args+=(-c "${prompt#config:}=$(jq -Rs . <"$SHARE/member-instruction.md")") ;;
    hook) ;; # no CLI flag exists; the SessionStart hook supplies the instruction
    *) die "harness $harness has no prompt injection method (prompt fact: '$prompt')" ;;
  esac
  exe=$(harness_fact "$harness" exe)
  "$exe" "${args[@]}" "$@" || true
  echo
  echo "[$harness exited — shell kept open; HIVE_MEMBER=$HIVE_MEMBER]"
  exec bash -l
fi

if [[ ${1:-} == --list ]]; then
  tmux list-sessions -F '#S  created #{t:session_created}  #{?session_attached,attached,detached}' 2>/dev/null \
    | grep '^hive-' || echo "(no member sessions)"
  exit 0
fi

member="${1:-}"; [[ -n $member ]] || die "usage: hive-launch <member> [$harnesses] [dir] [-- args...]"
shift
harness=claude
dir="$HIVE_ROOT/projects"
[[ $# -gt 0 && $1 != -- ]] && { harness="$1"; shift; }
[[ $# -gt 0 && $1 != -- ]] && { dir="$1"; shift; }
[[ ${1:-} == -- ]] && shift
require_harness "$harness"
[[ -d $dir ]] || die "no such directory: $dir"
dir=$(readlink -f "$dir")

# A public rename keeps the running environment and nest identity stable.
if resolved=$(hive _resolve "$member" 2>/dev/null); then member=$resolved; fi
[[ $member != beekeeper && ! -f $HIVE_ROOT/beekeepers/$member/state/beekeeper.json ]] || die "cannot launch a human Beekeeper identity"
hive join "$member" >/dev/null
session="hive-$member"

if ! tmux has-session -t "=$session" 2>/dev/null; then
  # Launch record: lets hive-member wake the member in the same place.
  jq -n --arg h "$harness" --arg d "$dir" --arg now "$(date --iso-8601=seconds)" \
    '{harness: $h, dir: $d, launched_at: $now}' >"$HIVE_ROOT/members/$member/state/launch.json"
  tmux new-session -d -s "$session" -c "$dir" \
    -e "HIVE_MEMBER=$member" \
    -e "HIVE_ROOT=$HIVE_ROOT" \
    -e "HIVE_USER=$HIVE_USER" \
    -e "HIVE_BIN_DIR=${HIVE_BIN_DIR:-}" \
    -e "HIVE_SHARE=$SHARE" \
    -e "PATH=$PATH:$HIVE_ROOT/tools/bin" \
    -e "HIVE_HARNESS=$harness" \
    -- "$0" --run "$harness" "$@"
  echo "hive-launch: started $session ($harness in $dir)"
fi

[[ -n ${HIVE_LAUNCH_NO_ATTACH:-} ]] && exit 0

if [[ -n ${TMUX:-} ]]; then
  exec tmux switch-client -t "=$session"
elif [[ -t 1 ]]; then
  exec tmux attach-session -t "=$session"
fi
