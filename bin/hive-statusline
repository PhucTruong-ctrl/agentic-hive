#!/usr/bin/env bash
# hive-statusline — Claude Code status line for Hive members.
#
# Claude Code pipes session JSON (including rate_limits.five_hour/seven_day)
# on stdin. For a Hive member this prints a one-line status and records the
# account quota in $HIVE_ROOT/telemetry/quota/claude.json for the dashboard.
# Outside Hive it prints only the model name. Never fails.
set -uo pipefail
umask 0002

HIVE_ROOT="${HIVE_ROOT:-/srv/hive}"
m="${HIVE_MEMBER:-}"
input=$(cat 2>/dev/null || true)
j() { jq -r "$1 // empty" <<<"$input" 2>/dev/null || true; }

model=$(j '.model.display_name')
if [[ -z $m || ! -w $HIVE_ROOT/telemetry ]]; then
  printf '%s\n' "${model:-}"
  exit 0
fi

# Record quota (throttled: only when it changed or every 60s).
limits=$(jq -c '.rate_limits // empty' <<<"$input" 2>/dev/null || true)
if [[ -n $limits && $limits != null ]]; then
  qdir="$HIVE_ROOT/telemetry/quota"
  qf="$qdir/claude.json"
  mkdir -p "$qdir" 2>/dev/null
  prev=$(jq -c '.rate_limits' "$qf" 2>/dev/null || true)
  age=$(($(date +%s) - $(stat -c %Y "$qf" 2>/dev/null || echo 0)))
  if [[ $prev != "$limits" || $age -ge 60 ]]; then
    tmp=$(mktemp "$qf.XXXXXX" 2>/dev/null) && jq -n \
      --argjson rl "$limits" --arg m "$m" --arg now "$(date --iso-8601=seconds)" '
        {harness: "claude", updated_at: $now, reported_by: $m, rate_limits: $rl,
         windows: [
           ($rl.five_hour | select(.) | {name: "5h", used_percent: .used_percentage, resets_at: .resets_at}),
           ($rl.seven_day | select(.) | {name: "week", used_percent: .used_percentage, resets_at: .resets_at}),
           ($rl.spend_limit | select(.) | {name: "spend", used_percent: .used_percentage, resets_at: .resets_at})
         ]}' >"$tmp" 2>/dev/null && chmod 0664 "$tmp" && mv -f "$tmp" "$qf" || rm -f "${tmp:-}"
  fi
fi

g=$(cat "$HIVE_ROOT/.room-generation" 2>/dev/null || echo '?')
c=$(cat "$HIVE_ROOT/members/$m/state/last-delivered-generation" 2>/dev/null || echo "$g")
unseen=""
[[ $g =~ ^[0-9]+$ && $c =~ ^[0-9]+$ ]] && ((g > c)) && unseen=" (+$((g - c)))"
q=$(jq -r '[(.five_hour.used_percentage | select(.) | "5h \(. | floor)%"),
            (.seven_day.used_percentage | select(.) | "wk \(. | floor)%")] | join(" · ")' <<<"${limits:-{\}}" 2>/dev/null || true)

printf '⬡ %s · room %s%s%s%s\n' "$m" "$g" "$unseen" "${q:+ · $q}" "${model:+ · $model}"
